{
  "name": "chat-blog",
  "private": true,
  "version": "1.3.5",
  "description": "个人对话式博客：对话主页 + 蒸馏后台",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.js",
    "lint": "npm --prefix web run lint",
    "install:all": "npm --prefix server install && npm --prefix web install",
    "snapshot": "powershell -ExecutionPolicy Bypass -File scripts/snapshot.ps1"
  }
}
